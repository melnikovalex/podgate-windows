<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- WinExe, not Exe: the uninstaller runs this binary directly to restore stock Bluetooth, and a
         console subsystem executable flashes a black window in the middle of an install. It still writes
         to a console when a person starts it from one; see AttachConsole in Program.cs. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>PodGate.Service</RootNamespace>
    <AssemblyName>PodGate.Service</AssemblyName>
    <UserSecretsId>podgate-service</UserSecretsId>
    <!-- Published next to the app (build.ps1), sharing its runtime files. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- Pipe ACLs come with the Windows target framework; no package needed. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodGate.Core\PodGate.Core.csproj" />
  </ItemGroup>

</Project>
