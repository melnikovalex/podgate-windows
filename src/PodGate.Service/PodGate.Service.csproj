<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PodGate.Service</RootNamespace>
    <AssemblyName>PodGate.Service</AssemblyName>
    <UserSecretsId>podgate-service</UserSecretsId>
    <!-- Published next to the app (build.ps1), sharing its runtime files. -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- Pipe ACLs come with the Windows target framework; no package needed. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodGate.Core\PodGate.Core.csproj" />
  </ItemGroup>

</Project>
