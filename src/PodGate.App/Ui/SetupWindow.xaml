<ui:DarkWindow x:Class="PodGate.App.Ui.SetupWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="clr-namespace:PodGate.App.Ui"
               Title="PodGate setup" Width="560" Height="640">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Step progress: hidden on the welcome page -->
    <StackPanel x:Name="StepHeader" Margin="32,4,32,0">
      <UniformGrid x:Name="Segments" Rows="1"/>
      <TextBlock x:Name="StepText" Style="{StaticResource Caption3}" Margin="0,8,0,0"/>
    </StackPanel>
    <Border x:Name="WelcomeSpacer" Height="32" Visibility="Collapsed"/>

    <Grid Grid.Row="1" Margin="32,24,32,0">

      <!-- 1 Welcome -->
      <StackPanel x:Name="WelcomePage">
        <ui:AirPodGlyph Width="64" Height="64" HorizontalAlignment="Left" Foreground="{StaticResource PodOn}"/>
        <TextBlock Style="{StaticResource Title}" Margin="0,20,0,0" Text="Don’t let Windows steal your AirPods"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,20"
                   Text="Windows connects your AirPods by itself, at startup and after sleep, and takes them away from your phone. PodGate stops that and connects them only when you ask."/>
        <Border Style="{StaticResource GroupBox}">
          <StackPanel>
            <Grid MinHeight="52">
              <ui:Glyph Data="{StaticResource G.Keyboard}" HorizontalAlignment="Left" Margin="18,0,0,0"/>
              <TextBlock Style="{StaticResource RowTitle}" Margin="52,0,16,0" VerticalAlignment="Center" Text="Connect with a shortcut or from the tray"/>
            </Grid>
            <Rectangle Style="{StaticResource RowSeparator}"/>
            <Grid MinHeight="52">
              <ui:Glyph Data="{StaticResource G.Sound}" HorizontalAlignment="Left" Margin="18,0,0,0"/>
              <TextBlock Style="{StaticResource RowTitle}" Margin="52,0,16,0" VerticalAlignment="Center" Text="Sound and call microphone switch over automatically"/>
            </Grid>
            <Rectangle Style="{StaticResource RowSeparator}"/>
            <Grid MinHeight="52">
              <ui:Glyph Data="{StaticResource G.Undo}" HorizontalAlignment="Left" Margin="18,0,0,0"/>
              <StackPanel Margin="52,10,16,10" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource RowTitle}" Text="Fully reversible"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" Text="Uninstall PodGate and Windows behaves as before"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 2 Choose AirPods -->
      <DockPanel x:Name="ChoosePage" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Style="{StaticResource Title}" Text="Choose your AirPods"/>
          <TextBlock Style="{StaticResource Body}" Margin="0,8,0,20"
                     Text="These are the Apple audio devices paired with this PC. PodGate will manage only the pair you choose."/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,0,0" DockPanel.Dock="Top" MaxHeight="300">
          <StackPanel>
            <Border Style="{StaticResource GroupBox}">
              <StackPanel x:Name="DeviceList"/>
            </Border>
            <TextBlock x:Name="OthersLabel" Style="{StaticResource SectionLabel}" Margin="4,16,0,8" Text="OTHER PAIRED DEVICES" Visibility="Collapsed"/>
            <Border x:Name="OthersBox" Style="{StaticResource GroupBox}" Visibility="Collapsed">
              <StackPanel x:Name="OtherList"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
          <Grid x:Name="PermissionNote" Visibility="Collapsed">
            <ui:Glyph Data="{StaticResource G.Shield}" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="28,0,0,0"
                       Text="Windows asks for administrator permission once, so PodGate’s background service knows which pair to manage. Nothing else on this PC changes."/>
          </Grid>
          <TextBlock x:Name="PermissionError" Style="{StaticResource Body}" FontSize="13" Margin="0,12,0,0"
                     Foreground="{StaticResource Red}" Visibility="Collapsed"
                     Text="PodGate didn’t get permission, so nothing was saved. Choose Next to try again."/>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,12,0,0" x:Name="DeviceLinks">
          <Button x:Name="ShowOthersLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"/>
          <Button x:Name="PairNewLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Pair new AirPods" VerticalAlignment="Center"/>
              <ui:Glyph Data="{StaticResource G.External}" Width="14" Height="14" Margin="6,0,0,0"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>
        </Grid>
        <Border/>
      </DockPanel>

      <!-- 2b No AirPods paired -->
      <StackPanel x:Name="NoAirPodsPage" Visibility="Collapsed">
        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Group}" HorizontalAlignment="Left">
          <ui:Glyph Data="{StaticResource G.Bluetooth}" Width="26" Height="26"/>
        </Border>
        <TextBlock Style="{StaticResource Title}" Margin="0,20,0,0" Text="No AirPods paired yet"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,20"
                   Text="PodGate works with AirPods that are already paired with this PC. Pair them once in Windows, then come back here."/>
        <Border Style="{StaticResource GroupBox}" Padding="16,18">
          <StackPanel>
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Fill3}" VerticalAlignment="Top">
                <TextBlock Text="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Style="{StaticResource RowTitle}" Margin="12,1,0,0" Text="Put the AirPods in their case and open the lid."/>
            </DockPanel>
            <DockPanel Margin="0,14,0,0">
              <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Fill3}" VerticalAlignment="Top">
                <TextBlock Text="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Style="{StaticResource RowTitle}" Margin="12,1,0,0" Text="Press and hold the button on the back of the case until the light flashes white."/>
            </DockPanel>
            <DockPanel Margin="0,14,0,0">
              <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Background="{StaticResource Fill3}" VerticalAlignment="Top">
                <TextBlock Text="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Style="{StaticResource RowTitle}" Margin="12,1,0,0">
                <Run Text="In Windows, choose "/><Bold>Add device</Bold><Run Text=" › "/><Bold>Bluetooth</Bold><Run Text=" and pick your AirPods."/>
              </TextBlock>
            </DockPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 4 Shortcuts -->
      <StackPanel x:Name="ShortcutsPage" Visibility="Collapsed">
        <TextBlock Style="{StaticResource Title}" Text="Set your shortcuts"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,20"
                   Text="These work everywhere, even when PodGate is in the background. Change one if it clashes with something you use, and test it to see it arrive."/>
        <Border Style="{StaticResource GroupBox}">
          <StackPanel>
            <ui:HotkeyRow x:Name="SetupToggleRow" Action="Toggle" Title="Connect or disconnect" Subtitle="Music and calls"/>
            <Rectangle Style="{StaticResource RowSeparator}" Margin="16,0,0,0"/>
            <ui:HotkeyRow x:Name="SetupMusicRow" Action="ConnectMusic" Title="Connect for music" ShowMusicDot="True"
                          Subtitle="Best sound quality, microphone stays on this PC"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- 5 Test -->
      <StackPanel x:Name="TestPage" Visibility="Collapsed">
        <TextBlock Style="{StaticResource Title}" Text="Try it with your AirPods"/>
        <TextBlock Style="{StaticResource Body}" Margin="0,8,0,20"
                   Text="Put your AirPods in your ears. PodGate disconnects them, then connects them to this PC the way your shortcut will."/>
        <Border Style="{StaticResource GroupBox}">
          <StackPanel x:Name="TestSteps"/>
        </Border>
        <Border x:Name="TestProblem" Background="{StaticResource RedTint}" CornerRadius="12" Padding="16,14" Margin="0,20,0,0" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="TestProblemTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Label}" TextWrapping="Wrap"/>
            <TextBlock x:Name="TestProblemText" Style="{StaticResource Body}" FontSize="13" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="TestBarTrack" Height="4" CornerRadius="2" Background="{StaticResource Group}" Margin="0,20,0,0">
          <Border x:Name="TestBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource TestFill}"/>
        </Border>
      </StackPanel>

      <!-- 6 Done -->
      <StackPanel x:Name="DonePage" Visibility="Collapsed">
        <Border x:Name="DoneBadge" Width="56" Height="56" CornerRadius="28" Background="{StaticResource GreenTint}" HorizontalAlignment="Left">
          <ui:Glyph Data="{StaticResource G.Check}" Width="28" Height="28" StrokeThickness="2.4" Stroke="{StaticResource Green}"/>
        </Border>
        <TextBlock x:Name="DoneTitle" Style="{StaticResource Title}" Margin="0,20,0,0" Text="You’re all set"/>
        <TextBlock x:Name="DoneBody" Style="{StaticResource Body}" Margin="0,8,0,20"/>
        <Border Style="{StaticResource GroupBox}">
          <StackPanel>
            <Grid MinHeight="52">
              <ui:AirPodGlyph Width="24" Height="24" HorizontalAlignment="Left" Margin="16,0,0,0" Foreground="{StaticResource PodOn}"/>
              <StackPanel Margin="52,10,16,10" VerticalAlignment="Center">
                <TextBlock x:Name="DoneDeviceName" Style="{StaticResource RowTitle}"/>
                <TextBlock x:Name="DoneDeviceState" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource RowSeparator}"/>
            <Grid MinHeight="52">
              <ui:Glyph Data="{StaticResource G.Keyboard}" HorizontalAlignment="Left" Margin="18,0,0,0"/>
              <TextBlock Style="{StaticResource RowTitle}" Margin="52,0,0,0" VerticalAlignment="Center" Text="Connect or disconnect"/>
              <ItemsControl x:Name="DoneToggleKeys" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Focusable="False"
                            ItemTemplate="{StaticResource KeycapTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"/>
            </Grid>
            <Rectangle Style="{StaticResource RowSeparator}"/>
            <Grid MinHeight="52">
              <ui:AirPodGlyph Width="24" Height="24" HorizontalAlignment="Left" Margin="16,0,0,0" Foreground="{StaticResource Purple}"/>
              <TextBlock Style="{StaticResource RowTitle}" Margin="52,0,0,0" VerticalAlignment="Center" Text="Connect for music"/>
              <ItemsControl x:Name="DoneMusicKeys" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Focusable="False"
                            ItemTemplate="{StaticResource KeycapTemplate}" ItemsPanel="{StaticResource HorizontalPanel}"/>
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="0,20,0,0">
          <Run Text="PodGate stays in the tray. Click its icon for the menu, and choose "/><Run Text="Set up again" FontWeight="SemiBold" Foreground="{StaticResource Label}"/><Run Text=" or "/><Run Text="Settings" FontWeight="SemiBold" Foreground="{StaticResource Label}"/><Run Text=" to change any of this later."/>
        </TextBlock>
      </StackPanel>
    </Grid>

    <!-- Footer -->
    <Grid Grid.Row="2" Margin="32,20,32,24">
      <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Back"/>
      <TextBlock x:Name="FooterNote" Style="{StaticResource Caption3}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="SkipButton" Style="{StaticResource SecondaryButton}" Content="Skip" Margin="0,0,12,0"
              Visibility="Collapsed"/>
      <Button x:Name="NextButton" Style="{StaticResource PrimaryButton}">
        <StackPanel Orientation="Horizontal">
          <Viewbox x:Name="NextShield" Width="16" Height="16" Margin="0,0,8,0" Visibility="Collapsed">
            <Canvas Width="16" Height="16">
              <Path Data="M8,1 L14,3.5 L14,7.7 C14,11.2 11.5,14.2 8,15 C4.5,14.2 2,11.2 2,7.7 L2,3.5 Z" Fill="#FF1C1C1E"/>
              <Path Data="M8,1 L8,15 C11.5,14.2 14,11.2 14,7.7 L14,3.5 Z" Fill="#FF48484A"/>
            </Canvas>
          </Viewbox>
          <ui:Glyph x:Name="NextExternal" Data="{StaticResource G.External}" Width="16" Height="16" Margin="0,0,8,0"
                    Stroke="{StaticResource Dark}" Visibility="Collapsed"/>
          <TextBlock x:Name="NextText" Text="Next" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      </StackPanel>
    </Grid>
  </Grid>
</ui:DarkWindow>
