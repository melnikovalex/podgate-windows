<ui:DarkWindow x:Class="PodGate.App.Ui.AudioWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="clr-namespace:PodGate.App.Ui"
               Title="PodGate audio devices" Width="520" Height="470">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Margin="32,16,32,0">
      <TextBlock x:Name="HeadingText" Style="{StaticResource Title}" FontSize="20"/>
      <TextBlock x:Name="ExplanationText" Style="{StaticResource Body}" Margin="0,8,0,20"/>

      <TextBlock Style="{StaticResource Caption}" Text="Output"/>
      <ComboBox x:Name="OutputBox" Style="{StaticResource DarkCombo}" Margin="0,6,0,14"/>

      <TextBlock Style="{StaticResource Caption}" Text="Microphone"/>
      <ComboBox x:Name="MicrophoneBox" Style="{StaticResource DarkCombo}" Margin="0,6,0,14"/>

      <TextBlock Style="{StaticResource Caption}" Text="Microphone for calls"/>
      <ComboBox x:Name="CallMicrophoneBox" Style="{StaticResource DarkCombo}" Margin="0,6,0,0"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="32,16,32,24">
      <TextBlock Style="{StaticResource Caption3}" VerticalAlignment="Center" Text="Saved as you choose"/>
      <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Content="Done"/>
    </Grid>
  </Grid>
</ui:DarkWindow>
