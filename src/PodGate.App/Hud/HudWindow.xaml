<Window x:Class="PodGate.App.Hud.HudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False"
        SizeToContent="Manual" Width="360" Height="96" Opacity="0">
  <!-- Neutral iOS dark-HUD palette: systemGray tones, no brand colour. -->
  <Border CornerRadius="20" Background="#F21C1C1E" BorderThickness="1" BorderBrush="#22FFFFFF">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="#000000"/>
    </Border.Effect>
    <Grid Margin="22,18,22,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <TextBlock x:Name="TitleText" Foreground="#FFFFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI"
                   FontSize="15" FontWeight="SemiBold" Text="AirPods"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <!-- Battery lands here in Phase E: grey above 20%, yellow at 20, red at 5, percentage on hover. -->
          <Border x:Name="BatteryBadge" Visibility="Collapsed" Margin="0,0,8,0" Padding="6,2"
                  CornerRadius="7" Background="#28FFFFFF">
            <TextBlock x:Name="BatteryText" Foreground="#FFEBEBF5" FontSize="11" Text=""/>
          </Border>

          <!-- Hides the card only. It deliberately cannot cancel a connect or release: stopping
               half way through would leave the device in a state nobody asked for. -->
          <Border x:Name="CloseButton" Width="20" Height="20" CornerRadius="10" Margin="0,-2,0,0"
                  Background="Transparent" Cursor="Hand" ToolTip="Hide (the action continues)">
            <TextBlock Text="x" Foreground="#FFEBEBF5" Opacity="0.75" FontSize="12" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Grid>

      <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,2,0,10" Foreground="#FFFFFFFF" Opacity="0.65"
                 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Text="Working..."/>

      <Border x:Name="Track" Grid.Row="2" Height="5" CornerRadius="3" Background="#FF48484A">
        <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="#FFE5E5EA"/>
      </Border>
    </Grid>
  </Border>
</Window>
