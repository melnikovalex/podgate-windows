<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe is the whole point: a windows application never allocates a console, so nothing can
         flash on a hotkey press. -->
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PodGate.App</RootNamespace>
    <AssemblyName>PodGate</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PodGate.UiSnapshots" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodGate.Core\PodGate.Core.csproj" />
  </ItemGroup>

</Project>
